    given-names: "Olmo S."
    affiliation: "Department of Scientific Computing, Florida State University"
    role: "Principal Investigator"
  - name: "Brendon DGR"
    role: "Graduate research assistant, technical lead"
repository-code: "https://github.com/brendondgr/Ariadne"
license: Apache-2.0
version: "0.1.0"
date-released: "2026-09-12"
keywords:
  - knowledge graphs
  - federated query
  - question answering
  - cybersecurity
  - MITRE ATT&CK
  - MITRE CAPEC
