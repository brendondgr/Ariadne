{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ariadne-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "web",
      "port": 16500
    },
    {
      "name": "ariadne-app",
      "runtimeExecutable": "python",
      "runtimeArgs": ["app.py"],
      "port": 16500
    },
    {
      "name": "ariadne-app-alt",
      "runtimeExecutable": "python",
      "runtimeArgs": ["app.py", "--port", "16600", "--api-port", "16601"],
      "port": 16600
    }
  ]
}
