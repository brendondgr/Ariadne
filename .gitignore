docs/_build/

# Pyre type checker
.pyre/

# MyPy
.mypy_cache/

# Rope project
.ropeproject

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store

