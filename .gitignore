node_modules/
web/dist/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
# Data directories (generated artifacts ignored; authored overlays and version pins tracked)
/data/*
!/data/versions.json
!/data/source_cards/
/data/source_cards/*
!/data/source_cards/overlays/
# Log directories
logs/

# Docker runtime data (compose layout and version pins stay tracked)
# The C-015 merged-graph counterfactual's dataset: both catalogues concatenated
# into one, ~22 MB, regenerated by `python -m utils.kg_builder.merge`. Derived
# exactly like data/graphs/, so ignored exactly like it. The builder is the
# record; the artifacts are not.
/data-merged/

# EXP-2026-08-011's dataset: the declared catalog artifact plus a seeded
# synthetic tenant conforming to it. Derived exactly like data/graphs/, so
# ignored exactly like it -- the reader and the generator are the record. The
# delivered ReliaQuest CSVs are NOT here and must never be: they are
# funder-supplied, not redistributable, and are referenced by checksum from
# docs/research/datasets/cards/reliaquest-identity-catalog.md.
# Ignore the derived tree level by level, because git cannot re-include a file
# whose parent directory is excluded -- a plain `!/data-identity/source_cards/
# overlays/*.json` after `/data-identity/` silently un-ignores nothing (or, if
# the directory is negated instead, un-ignores everything).
/data-identity/*
!/data-identity/source_cards/
/data-identity/source_cards/*

# Composed by scripts/tri_compose.py — three source cards in one directory,
# so the planner can hold ATT&CK, CAPEC and the identity graph at once. Derived,
# like every other card directory; the recipe is what is committed.
/data-tri/
!/data-identity/source_cards/overlays/
# The negation has to name the FILE, not just the directory: the blanket
# `*.overlay.json` at the top of this file is an earlier rule, and a later rule
# only wins where it actually matches. A directory-only negation leaves the file
# itself still caught by line 5.
!/data-identity/source_cards/overlays/*.overlay.json
# The overlay is SOURCE, not derived: connection details, safety limits, and the
# 72 node and 21 relationship glosses -- the half of the source card no catalog
# can supply, and the deterministic planner's only signal for telling six kinds
# of "group" apart. Same exception the ATT&CK and CAPEC overlays get above.

# The identity store (EXP-2026-08-011). Same reasoning as neo4j-merged below.
docker/neo4j-identity/

docker/neo4j/data/*
!docker/neo4j/data/.gitkeep
# The merged-graph counterfactual's store (C-015). Same reasoning as above:
# a live Neo4j data directory is not source, and this one is created the
# moment `docker compose --profile merged up` runs.
# (No .gitkeep counterpart: the container creates this directory owned by
# Neo4j's uid, so the placeholder cannot be written from the host.)
docker/neo4j-merged/
# Golden-eval harness run artifacts (regenerate via `main.py --golden-eval`)
docs/evaluation/golden/

# Variance-sweep run output (EXP-2026-08-015): per-question answers and
# per-arm sweep state, ~9MB across 20 bank-runs. The banks themselves and the
# computed metrics.json ARE committed — they are the experiment's inputs and
# its result. The bulky run trees are pinned by hash in the experiment's
# POINTERS.md, matching how docs/evaluation/experiments is already handled.
docs/evaluation/variance-2026-08-23/*/runs/
docs/evaluation/variance-2026-08-23/identity/*/sweep_state.json
