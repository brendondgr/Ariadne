# Custom
# (data/ policy is defined below: generated artifacts ignored, authored
#  overlays and version pins tracked — see the "# Data directories" block.
#  A blanket `data/` here would shadow those negations, so it is omitted.)
*.overlay.json
# Raw run output under docs/evaluation/experiments (decision 2026-09-09, D-033):
# per-question ANSWER files stay out of git (~320 MB) and are pinned by hash in
# each experiment's data/POINTERS.md; the per-question JUDGMENT sidecars
# (*.judgment.*, ~21 MB) and every per-run roll-up are tracked, because they are
# what every judged figure in the record is recomputed from.
docs/evaluation/experiments/**/answers/*
docs/evaluation/experiments/**/predictions.jsonl
!docs/evaluation/experiments/**/answers/*.judgment.*

# python/.gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
.installed.cfg
*.egg
lib/
lib64/
# web/ is a Next.js app — web/lib/ is application source, not a Python build dir
!web/lib/
!web/lib/**
parts/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/

# Virtual environments
.env
!docker/.env
.venv/
venv/
ENV/
env/
env.bak/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

