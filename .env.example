# =============================================================================
# Ariadne — Central Project Configuration
# =============================================================================
# This is the SINGLE place to change tunable settings for the project. Copy it
# to a live, git-ignored `.env` and edit that:
#
#     cp .env.example .env
#
# How it is consumed:
#   * Python side  — `utils/config.load_env()` (called from main.py) loads this
#                    file into the environment; each module reads its values
#                    with the documented defaults as fallback.
#   * Docker side  — `docker/docker-compose.yml` reads the same variable names
#                    (with `${VAR:-default}` fallbacks). `utils/infrastructure`
#                    layers this file on top of `docker/.env`.
#
# Rules of thumb:
#   * Real shell/CI environment variables always WIN over this file.
#   * Every value below is the project default — changing nothing here keeps
#     current behavior identical.
#   * Each section says WHAT it controls and WHERE it is read.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. DATASET VERSIONS
#    What: which MITRE source versions are downloaded and built.
#    Where: utils/download/downloader.py (download + versions.json),
#           utils/kg_builder (build paths derive from data/versions.json).
# -----------------------------------------------------------------------------
ATTACK_VERSION=19.0
CAPEC_VERSION=3.9


# -----------------------------------------------------------------------------
# 2. DATA DIRECTORY
#    What: root folder for raw downloads, processed pairs, and graph artifacts.
#    Where: utils/download, utils/kg_builder, utils/graph_loader.
# -----------------------------------------------------------------------------
ARIADNE_DATA_DIR=data

# Conversation threads database (stdlib SQLite). Empty -> default
# `${ARIADNE_DATA_DIR}/conversations.sqlite3` (gitignored). Set an absolute or
# relative path to override. Where: utils/conversation/config.py.
# ARIADNE_CONVERSATION_DB=

# Conversational orchestration layer (router/answer/validation/naming agents).
# By default the layer follows the workbench DRAFTER toggle: a turn sent with
# drafter="llm" turns the whole agentic flow on (orchestration resolves
# references from memory, the router decides quick-vs-graph, the answer agent
# memory-grounds), using the LANGUAGE MODEL group in section 8. A deterministic
# turn keeps the reproducible fallback path (router -> graph, validation -> pass,
# answer -> synthesis narrative, title -> truncated question).
#
# CONVERSATION_LLM_ENABLED=true forces the layer on for EVERY turn. The endpoint
# it uses is ARIADNE_LLM_* (section 8) unless CONVERSATION_LLM_BASE_URL and
# friends are set as a per-stage override (section 8b) -- they no longer chain
# through SYNTHESIS_LLM_*, which is how the chat pane came to be configured by a
# field labelled "synthesis" in a settings modal that never listed it.
#
# One thing worth knowing about the answer budget: ARIADNE_LLM_MAX_TOKENS is not
# the real ceiling. A local server caps the completion at n_ctx - prompt_tokens,
# so raising it past what the model's context window allows does nothing. A
# cut-off reply is logged as "finish_reason=length" with token counts and shown
# with an explicit truncation note; if you see that, raise the model's context
# window or narrow the question -- not just the budget.
# Where: utils/conversation/config.py + agents.
CONVERSATION_LLM_ENABLED=false
# Max re-extraction attempts when validation reports insufficient evidence.
ARIADNE_CONVERSATION_MAX_VALIDATION_ITERS=2
# Whether the router may pick the memory-grounded quick path (else always graph).
CONVERSATION_QUICK_ANSWER=true
# How many prior turns to feed the router/answer agents as memory.
CONVERSATION_HISTORY_TURNS=12


# -----------------------------------------------------------------------------
# 3. DOCKER IMAGE VERSIONS
#    What: container image tags for the local graph stack.
#    Where: docker/docker-compose.yml (image: neo4j:${NEO4J_VERSION}, etc.).
# -----------------------------------------------------------------------------
NEO4J_VERSION=5.26
GREMLIN_VERSION=3.8.0


# -----------------------------------------------------------------------------
# 4. DOCKER HOST PORTS
#    What: the localhost ports the stack is published on (left side of the
#          compose "host:container" mapping).
#    Where: docker/docker-compose.yml (port mappings) and
#           utils/infrastructure/docker_manager.py (readiness TCP checks).
#    NOTE: If you change NEO4J_BOLT_PORT or GREMLIN_PORT, also update the
#          matching URI in section 6 below — they must agree.
# -----------------------------------------------------------------------------
NEO4J_HTTP_PORT=5455
NEO4J_BOLT_PORT=5456
GREMLIN_PORT=6455
WEB_PORT=4455
# -----------------------------------------------------------------------------
# MERGED-GRAPH COUNTERFACTUAL (C-015) — optional, off unless you are running it
#
#    A SECOND Neo4j holding ATT&CK *and* CAPEC together, so the study can ask
#    whether federating two engines beats merging both sources into one graph.
#    It is a separate instance rather than a database inside the main one
#    because Neo4j Community serves exactly one database per instance: a merged
#    graph would otherwise have to be the graph every other arm queries, which
#    would turn `Mitigation` from 44 ATT&CK mitigations into both catalogues'
#    and silently invalidate figures already recorded against a clean graph.
#
#    Start it:  docker compose --profile merged up -d neo4j-merged
#    Load it:   NEO4J_URI=bolt://localhost:5458 ARIADNE_ALLOW_MERGED_GRAPH=1 \
#                 uv run main.py --dataset attack --graph neo4j
#               NEO4J_URI=bolt://localhost:5458 ARIADNE_ALLOW_MERGED_GRAPH=1 \
#                 uv run main.py --dataset capec  --graph neo4j
#
#    ARIADNE_ALLOW_MERGED_GRAPH relaxes post-load verification from "counts
#    match this dataset exactly" to "counts are at least this dataset" — an
#    undershoot still fails, because that means records did not land. Set it
#    ONLY for the merged store; on a normal load a mismatch is a real fault.
# -----------------------------------------------------------------------------
NEO4J_MERGED_HTTP_PORT=5457
NEO4J_MERGED_BOLT_PORT=5458



# -----------------------------------------------------------------------------
# 5. NEO4J CREDENTIALS
#    What: authentication for the Neo4j container and the runtime loader.
#    Where: NEO4J_AUTH -> docker/docker-compose.yml (container auth);
#           NEO4J_USER / NEO4J_PASSWORD -> utils/graph_loader (driver login).
#    NOTE: NEO4J_AUTH must stay in "<user>/<password>" form and match
#          NEO4J_USER / NEO4J_PASSWORD. This is a local dev default — do not
#          commit real secrets; the live `.env` is git-ignored.
# -----------------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_AUTH=neo4j/password


# -----------------------------------------------------------------------------
# 6. GRAPH CONNECTION URIs (Python runtime loaders)
#    What: endpoints the loader/verify commands connect to.
#    Where: utils/graph_loader/config.py (LoaderConfig.from_data_dir).
#    NOTE: host ports here must match section 4.
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:5456
GREMLIN_URI=ws://localhost:6455/gremlin


# -----------------------------------------------------------------------------
# 7. RUNTIME TUNING
#    What: operational knobs for loading and infrastructure startup.
#    Where: ARIADNE_LOAD_BATCH_SIZE -> utils/graph_loader/config.py;
#           ARIADNE_DOCKER_START_TIMEOUT -> utils/infrastructure/docker_manager.py.
# -----------------------------------------------------------------------------
ARIADNE_LOAD_BATCH_SIZE=500
ARIADNE_DOCKER_START_TIMEOUT=180


# -----------------------------------------------------------------------------
# 7b. ROUTER AND ANCHOR-RESOLUTION FLAGS (all default OFF)
#     What: three staged changes to how a question's entity is resolved, measured
#           in EXP-2026-08-020 and deliberately kept behind separate flags so
#           each one's contribution can be attributed. With all three off the
#           120 golden answers are byte-identical to the committed Arm 0 capture,
#           verified three times.
#     Where: utils/planner/lexicon.py, utils/specialists/cypher/builder.py,
#            utils/specialists/gremlin/builder.py,
#            utils/specialists/schema/namesearch.py.
# -----------------------------------------------------------------------------

# Stemming, gloss stems and bounded edit distance in the router, PLUS the fix
# that makes an unanchored question run a real bounded query instead of scanning
# a whole label. These are ONE change and must not be split: widening word
# matching on its own makes more questions route, and with no anchor resolved
# they fall through to the label scan and return everything. Measured: shipping
# the matcher alone raised catalogue dumps by 0.125 at T4 and wrong entities by
# 0.115 at T5. Together they are a clean gain -- catalogue gold recall
# 0.8698 -> 0.9161, 6 better / 0 worse, and 28 of 30 negative controls silent.
#
# DEFAULT: ON since 9f02dc6 (2026-08-31), after the regression run that gate
# required: +18 right, -8 wrong against the shipped baseline, catalogue
# regression unchanged at 6 better / 0 worse.
#
# LEFT UNSET ON PURPOSE. Setting it here would pin an override into every .env
# copied from this file, and that is not hypothetical: this block previously read
# `ARIADNE_LEXICON=false`, which would have silently reverted the newly-shipped
# behaviour for anyone who copied it. Set it to 0/false only to reproduce a
# pre-9f02dc6 arm.
# ARIADNE_LEXICON=

# Exact-name anchoring: if the question contains a complete entity name, resolve
# it by lookup. No threshold to tune. Measured at +3 answers gained for +1 wrong
# answer bought, with negative-control abstention held at 0.9333.
#
# DEFAULT: ON since 9f02dc6, same regression run. EXP-2026-08-020 called this "a
# shippable win"; it has now actually shipped, and name resolution also moved to
# the top of build() so a name-anchored question reaches the same template it
# would have reached had the analyst typed the identifier.
#
# LEFT UNSET ON PURPOSE, for the reason above.
# ARIADNE_EXACTNAME=

# Ranked (BM25) name matching. STAYS OFF, and the reason is measured rather than
# suspected. Its accept thresholds were tuned on a frozen split (Q28): margin
# >= 1.4 gave 12 right / 0 wrong on the tuning half and 17 right / 8 wrong on the
# half it had never seen -- 68% precision, barely better than the unfitted
# default's 67%. A 68%-precision anchor resolver does not belong in a system
# whose value proposition is not being confidently wrong. Any further threshold
# work needs a fresh split; the frozen half has been spent.
ARIADNE_NAMESEARCH=false


# -----------------------------------------------------------------------------
# 7c. HYBRID REWRITE STAGE (all default OFF)
#     What: one stage in front of the deterministic engine that rewrites a
#           question into a canonical tier-0 form in the source card's own
#           vocabulary. A deterministic pass binds every slot stems, exact names
#           and the resolver ladder can bind; a model may then fill what is left
#           by CHOOSING FROM CANDIDATE LISTS it cannot add to, behind a gate that
#           rejects anything off-list or off-card. The model renames and selects;
#           it never plans and never writes a query.
#     Where: utils/planner/canonical.py, utils/planner/rewrite_llm.py,
#            utils/planner/rewrite_cache.py, utils/planner/config.py.
#     Why off: EXP-2026-09-014. With both flags off the pipeline is
#           byte-identical to the captured reference, and every step of the
#           2026-09-08 plan re-proves that before anything else is believed.
# -----------------------------------------------------------------------------

# The deterministic half: fill the form and render the canonical question. No
# model, no network, byte-reproducible.
ARIADNE_REWRITE=1

# The model half. Requires ARIADNE_REWRITE. Consulted only for slots the
# deterministic pass left unbound, and only ever to pick an index out of a list.
ARIADNE_REWRITE_MODEL=1

# Run the stage ONLY on questions that cite no identifier.
#
# EXP-2026-09-021 measured the stage separately on the two populations it acts
# on. Where the question still names an identifier it broke 32 answers and fixed
# 10; where it names none it fixed 44 and broke 7 -- because canonicalising a
# question rewrites away the identifier the template ladder routes on. Gated,
# T3 (exact name, no identifier) goes 0.1782 -> 0.3267 while T1 and T2 return to
# baseline exactly. Shipped on by operator decision 2026-09-15; see D-041.
ARIADNE_REWRITE_ONLY_WITHOUT_ID=1

# ... and only when the anchor was bound by an exact lookup -- an identifier or a
# complete name. `deterministic_fill` refuses to guess an anchor (the ranked name
# index accepts at 68% precision), but the model rung would fill it anyway from a
# candidate list. EXP-2026-09-021 A-1: the model chose the anchor on 82 of 104
# T4 and 88 of 104 T5 variants, and wrong_entity tripled to 0.3077/0.2981. Gated,
# it falls to 0.1442/0.1346 while T3 keeps its full gain. The model may still fill
# relation, direction and mode -- never who the question is about. See D-035.
ARIADNE_REWRITE_REQUIRE_RESOLVED_ANCHOR=1

# -- EXP-2026-09-023: anchor hygiene and Q59 (plan docs/plans/2026-09-15-open-question-correctness.md)
#
# A one-word entity name binds only when the question writes it as a standalone
# proper noun (same casing, whole word, not inside a longer capitalised run,
# at least one indexable token). The sub-technique named "Credentials", the
# sub-technique named "Malware" and the tool named "at" supplied 54 wrong
# anchors on the exposed bank and 43 on the sealed one; every unique bind at T3
# was gold. `df` selects the falsified frequency rule (H1) for reproduction
# only. Off until the step ships (Step 10); the harness `hygiene` arm sets it.
ARIADNE_EXACT_NAME_DISTINCT=0

# A relation template with no anchor abstains instead of scanning the
# catalogue (558 CAPEC rows, 222 tactic->technique rows). Travels with the rule
# above: the false anchor it removes is what kept those questions off the
# seedless branch. A concept-scoped bridge and an explicit bulk scan are
# untouched.
ARIADNE_UNANCHORED_RELATION_ABSTAINS=0

# Q59: look an exact name up across every live source BEFORE choosing a
# dataset, and let the name's owner lead when the router picked nothing or a
# source that does not hold the entity. The router's own selection is the
# tie-break when the same name exists in two catalogues (Phishing, Brute
# Force); a collision nothing breaks is reported as an ambiguity, never
# resolved by dataset order. Off until the step ships; the `anchor_first` arm.
ARIADNE_ANCHOR_BEFORE_ROUTING=0

# Where the model's picks are cached, keyed by (prompt version, served model,
# question). A cache hit costs nothing and makes an evaluation re-run free and
# repeatable. Unset means the process default.
# ARIADNE_REWRITE_CACHE_DIR=


# -----------------------------------------------------------------------------
# 8. LANGUAGE MODEL
#    What: the LLM seam used to draft plans and queries, compose narrative,
#          answer in the chat pane, and (offline) judge answers.
#    Where: utils/llm/config.py resolves it; utils/llm/client.py makes the call.
#           Also editable from the web workbench: Settings (the gear) -> Language
#           model, which writes exactly the variables below.
#
#    THIS IS ONE GROUP. Set these four and every stage follows them. It used to
#    be five parallel groups -- PLANNER_/SPECIALIST_/SYNTHESIS_/CONVERSATION_/
#    EVAL_LLM_* -- each with its own endpoint, model, timeout and budget, which
#    read as flexibility and behaved as confusion: the chat pane ran on the
#    CONVERSATION group, which silently inherited SYNTHESIS, and which the
#    settings modal did not show at all.
#
#    Disabled by default. The deterministic path is always the fallback, so
#    leaving ARIADNE_LLM_ENABLED=false keeps behaviour identical.
# -----------------------------------------------------------------------------
ARIADNE_LLM_ENABLED=false

# Which kind of backend. Decides message shape, auth header and token field:
#   openai-compatible  (default) vLLM, llama.cpp, Ollama's /v1, LM Studio,
#                      DeepSeek, or any proxy speaking POST /chat/completions
#   openai             api.openai.com
#   anthropic          Claude
#   gemini             Google
#   ollama             Ollama's own /v1
# A hosted provider selected without an explicit BASE_URL below gets its vendor
# endpoint rather than localhost.
ARIADNE_LLM_PROVIDER=openai-compatible

ARIADNE_LLM_BASE_URL=http://localhost:9090/v1
ARIADNE_LLM_MODEL=default-model

# Required by openai / anthropic / gemini; unnecessary for a local server, which
# is why it is empty by default. The workbench accepts it write-only -- it is
# stored here and never returned by the API. Prefer a real shell env var over
# this file if you would rather not have a key on disk at all.
# ARIADNE_LLM_API_KEY=

# Local generation legitimately takes minutes. A local server that is NOT
# running fails in about five seconds regardless: connect and read timeouts are
# separate numbers (utils/llm/config.py, DEFAULT_CONNECT_TIMEOUT_S), because one
# value cannot be both.
ARIADNE_LLM_TIMEOUT_S=30.0
ARIADNE_LLM_MAX_TOKENS=4096

# Cap on a reasoning model's THINKING tokens, and the one number most worth
# understanding here.
#
# 0 means "send no cap", which is what every run predating the cap did, and is
# the default. A positive value MUST be strictly less than ARIADNE_LLM_MAX_TOKENS:
# a budget that consumes the whole allowance leaves nothing for the answer, and
# the model returns EMPTY CONTENT -- which reaches a caller as a silent "LLM
# unavailable" fallback rather than as an error. The API refuses such a pair with
# a 422 naming the field; a hand-edit here is clamped with a warning instead.
#
# For scale: the record has a served model spending 4,134 tokens of answer behind
# 16,106 characters of preamble, and 42,602 characters when given no cap at all.
#
# BEHAVIOUR CHANGE (2026-09-07): SynthesisConfig used to DERIVE this as half of
# max_tokens when unset, so raising the token cap silently moved the budget. That
# derivation is gone. A deployment that set the old SYNTHESIS_LLM_MAX_TOKENS and
# no budget previously got an implicit cap and now gets none; set this explicitly
# to keep one. LLM_THINKING_BUDGET is still honoured as an alias for this
# variable, so the recorded runs under scripts/ that set it are unaffected.
ARIADNE_LLM_THINKING_BUDGET=0


# -----------------------------------------------------------------------------
# 8b. PER-STAGE OVERRIDES (optional; every one of them unset by default)
#
#     Any <STAGE>_LLM_<FIELD> below overrides the group above for that stage
#     only. Lookup is:  <STAGE>_LLM_X  ->  ARIADNE_LLM_X  ->  the built-in default.
#     Stages: PLANNER, SPECIALIST, SYNTHESIS, CONVERSATION, EVAL.
#     Fields: ENABLED, PROVIDER, BASE_URL, MODEL, API_KEY, TIMEOUT_S,
#             MAX_TOKENS, THINKING_BUDGET.
#
#     Set one when you genuinely want a second model -- the judge on another GPU,
#     a cheap local model for routing and a hosted one for the visible answer.
#     The workbench exposes these under Settings -> Per-stage endpoints, where
#     each stage reads "inherit" until you override it. Switching a stage back to
#     inherit CLEARS its variables here rather than copying the group's current
#     values in, because copying would pin the stage to a snapshot that stops
#     tracking the group the next time it changes.
#
#     MAX_TOKENS and THINKING_BUDGET are COUPLED: overriding either for a stage
#     carries both, so a stage can never run a budget sized against another
#     scope's token cap.
#
#     These names are also what every arm under docs/research/experiments/ and
#     the scripts under scripts/ pin, which is why they still exist. An
#     experiment protocol that sets SPECIALIST_LLM_TIMEOUT_S keeps working
#     exactly as it did.
#
#     Examples, deliberately commented out:
#       EVAL_LLM_BASE_URL=http://localhost:4000/v1
#       EVAL_LLM_MODEL=gemma-judge
#       EVAL_LLM_MAX_TOKENS=32000
#       EVAL_LLM_THINKING_BUDGET=0
# -----------------------------------------------------------------------------

# Two per-stage flags that are NOT endpoint settings and have no group-level
# equivalent -- they select a different code path, not a different model.

# Lets a model PROPOSE claims, which the verifier then gates. Kept as an
# instrument, never a default: it is the only configuration in which the
# verifier's four gates have anything to cut (0 of 888 deterministic claims
# versus 32-36 per run of LLM-proposed ones, EXP-2026-08-014 / -018), and it is
# 67x slower with 0.1367 less of the gold reaching a supported claim.
SYNTHESIS_LLM_CLAIMS=false

# Hands a model the schema, the resolved seeds and the gate's constraints and
# lets it write the Cypher or Gremlin itself (utils/specialists/llm_builder.py).
# It exists to be MEASURED AGAINST, not run: on 30 unseen questions it scored
# 0.5000 where the template cascade scored 0.9467 (EXP-2026-08-008), and the fair
# re-run at n=284 scored 0.3781 against 0.6569 (EXP-2026-09-002, 2026-09-05).
# Leave it false on any path whose answer anybody will read.
SPECIALIST_LLM_QUERY_BUILDER=false

# How many answers the LLM judge scores per run when enabled (the deterministic
# proxy always covers every answer regardless of this cap).
EVAL_LLM_SAMPLE_SIZE=20

# LangGraph orchestration layer. The Q/A pipeline runs as a compiled LangGraph
# StateGraph:
#
#   check_cards -> probe -> plan -> announce_querying -> specialists -> bundle
#                                                                        |
#                                        +-------------------------------+
#                                        v
#                                     assess --(sufficient)--> synthesize -> END
#                                        |
#                                   (insufficient)
#                                        v
#                                     replan --> announce_querying (next hop)
#
# (`plan` also has a plan-only exit that ends the run without querying.)
# Where: utils/orchestration/main.py (build_pipeline_graph, the add_node /
#        add_edge block).
#
# The checkpointer is opt-in (request-scoped queries do not need persistence);
# the recursion limit bounds graph supersteps (planner revise + specialist
# loop). The total pipeline deadline is PIPELINE_TIMEOUT_S (seconds, default
# 120): specialists that would start after the deadline are skipped honestly.
# Where: utils/specialists/pipeline.py (pipeline_timeout_s).
# Where: utils/orchestration/config.py (OrchestrationConfig.from_env).
#
# Two honest caveats about the assess/replan cycle above:
#
#   * At ORCH_MAX_HOPS=1 the cycle is INERT. The assess node force-terminates
#     on the first pass (`hop >= max_hops` short-circuits the verdict to
#     sufficient, utils/orchestration/agents/assess/policy.py), collapsing the
#     graph back to bundle -> synthesize.
#   * ORCH_ASSESS_MODE=llm currently DEGRADES to the deterministic judge no
#     matter what. The LLM critic is an injected dependency and nothing injects
#     it: utils/orchestration/main.py calls `build_assess_node(orch)` with no
#     `critic=`, so the `critic is None` branch in
#     utils/orchestration/agents/assess/policy.py records
#     "deterministic (llm fallback)" and moves on. The key is wired end to end
#     except for the critic itself.
ORCH_CHECKPOINTER=false
ORCH_RECURSION_LIMIT=200
PIPELINE_TIMEOUT_S=120

# Hard cap on assess -> replan -> specialists iterations. The CODE DEFAULT IS 5
# (utils/orchestration/config.py, DEFAULT_MAX_HOPS), so a fresh clone that
# leaves this unset runs with the retrieval loop ON. Every arm in the standing
# evaluation record (docs/evaluation/2026-07-26/) that is not marked "+ loop"
# was run with the loop pinned OFF at 1; the loop arms (E and F) used 5. Set it
# explicitly rather than inheriting the default, so what you ran is recorded.
#   1 = single pass, byte-reproducible, matches Arms A/B/C/D
#   5 = loop enabled, matches Arms E/F/G
# Ships at 5. The 2026-09 evaluation record is entirely at 5, so 1 made the
# committed default a configuration no recorded figure describes.
ORCH_MAX_HOPS=5

# The sufficiency judge used by the assess node, and the facet frontier it may
# chase. Both values below are the code defaults, so uncommenting nothing and
# copying nothing changes current behavior.
#   ORCH_ASSESS_MODE: deterministic | llm. Per the caveat above, `llm` degrades
#     to the deterministic judge until a critic is injected.
#   ORCH_CHASE_FACETS: treat a question-relevant, un-fetched facet as an unmet
#     gap and re-plan an expansion hop for it. Off keeps the LLM-off build
#     byte-reproducible and keeps every committed single-pass baseline valid.
#   ORCH_MAX_FACET_EXPANSIONS: how many facet expansions one re-plan hop may add.
ORCH_ASSESS_MODE=deterministic
# Ships ON as of 2026-09-14. EXP-2026-09-020 A-6: +0.0358 gold coverage at
# production's plan source, separable, 15 questions improved and 0 worsened,
# and T6 entity fidelity is UNCHANGED against the shipped reference
# (wrong_entity 0.0950, catalogue_dump 0.0915). The cheapest real gain on
# record: it costs nothing on the instrument that refused the engine merge.
ORCH_CHASE_FACETS=true
ORCH_MAX_FACET_EXPANSIONS=4
