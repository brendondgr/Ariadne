   <Attack_Patterns>
      <Attack_Pattern ID="560" Name="Use Alternate Authentication Material" Abstraction="Detailed" Status="Stable">
         <Description>Use alternate authentication material such as password hashes.</Description>
         <Related_Attack_Patterns>
            <Related_Attack_Pattern Nature="ChildOf" CAPEC_ID="122"/>
         </Related_Attack_Patterns>
         <Execution_Flow>
            <Attack_Step>
               <Step>1</Step>
               <Phase>Explore</Phase>
               <Description>Locate credential material.</Description>
               <Technique>Search local stores</Technique>
            </Attack_Step>
            <Attack_Step>
               <Step>2</Step>
               <Phase>Exploit</Phase>
               <Description>Use captured hashes.</Description>
            </Attack_Step>
         </Execution_Flow>
